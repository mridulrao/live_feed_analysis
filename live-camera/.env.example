# Local backend only. Copy to live-camera/.env (ignored by Git).
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
LIVEKIT_CONTROL_ROOM=onestreamer-control
LIVEKIT_BACKEND_IDENTITY=camera-backend
LIVEKIT_WORKER_IDENTITY=camera-gpu

# Optional. If omitted, .runtime/local-access-key is generated on first startup.
# LOCAL_ACCESS_KEY=at-least-24-random-characters

# Optional OpenAI second opinion. Never copy this key to the GPU worker.
OPENAI_API_KEY=
OPENAI_VERIFY_MODEL=gpt-4.1-mini
