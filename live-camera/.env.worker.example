# Copy to /workspace/.onestreamer-livekit.env on RunPod; chmod 600 that file.
# Use the same project, room and identities as the local backend.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
LIVEKIT_CONTROL_ROOM=onestreamer-control
LIVEKIT_BACKEND_IDENTITY=camera-backend
LIVEKIT_WORKER_IDENTITY=camera-gpu
ONESTREAMER_WORKSPACE=/workspace

# Load detection/tracking plugins at worker startup, independent of the UI toggle.
# Set false for an observation-only worker; enabling tracking in the UI is then rejected.
TRACKING_MODELS_ENABLED=true
DETECTION_PLUGIN=locate_anything
TRACKING_PLUGIN=csrt
LOCALIZATION_RETRY_SECONDS=1
# Defaults below match setup-tracking.sh. Override for a custom installation.
# Use a separate environment containing NVIDIA Eagle/Embodied dependencies.
LOCATE_ANYTHING_PYTHON=/workspace/locate-anything-env/bin/python
LOCATE_ANYTHING_SOURCE=/workspace/Eagle/Embodied
LOCATE_ANYTHING_MODEL=/workspace/models/LocateAnything-3B
# Enable only after downloading the model's batch_utils and kernel_utils files.
LOCATE_ANYTHING_BATCH_RUNTIME=0
